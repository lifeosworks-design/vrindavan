{% doc %}
  @prompt
    Create a clean and modern product price tag for a Shopify store. The design should be simple, minimal, and eye-catching. Use smooth rounded edges, soft shadows, and a premium e-commerce style. Include space for product name, price, discount price, and a small offer badge. The tag should look professional and suitable for online store product listings. Use colors that match most Shopify themes and ensure the typography is bold, readable, and attractive." , THE PRICES WILL DIFFER BY THE PRODUCT
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-price-tag-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-price-tag-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
    }
  }

  .ai-price-tag-container-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    box-shadow: 0 {{ block.settings.shadow_offset }}px {{ block.settings.shadow_blur }}px {{ block.settings.shadow_color }};
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-price-tag-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badge_position_top }}px;
    right: {{ block.settings.badge_position_right }}px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-price-tag-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-price-tag-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-price-tag-prices-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-price-tag-current-price-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: {{ block.settings.price_font_weight }};
    margin: 0;
  }

  .ai-price-tag-original-price-{{ ai_gen_id }} {
    color: {{ block.settings.original_price_color }};
    font-size: {{ block.settings.original_price_font_size }}px;
    font-weight: 400;
    text-decoration: line-through;
    opacity: 0.7;
    margin: 0;
  }

  .ai-price-tag-discount-{{ ai_gen_id }} {
    color: {{ block.settings.discount_color }};
    font-size: {{ block.settings.discount_font_size }}px;
    font-weight: 600;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-price-tag-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.85 }}px;
    }

    .ai-price-tag-current-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.price_font_size | times: 0.85 }}px;
    }

    .ai-price-tag-original-price-{{ ai_gen_id }} {
      font-size: {{ block.settings.original_price_font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<product-price-tag-{{ ai_gen_id }} class="ai-price-tag-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-price-tag-container-{{ ai_gen_id }}">
    {% if block.settings.show_badge and block.settings.badge_text != blank %}
      <div class="ai-price-tag-badge-{{ ai_gen_id }}">
        {{ block.settings.badge_text }}
      </div>
    {% endif %}

    <div class="ai-price-tag-content-{{ ai_gen_id }}">
      {% if block.settings.show_title %}
        <h3 class="ai-price-tag-title-{{ ai_gen_id }}">
          {{ product.title }}
        </h3>
      {% endif %}

      <div class="ai-price-tag-prices-{{ ai_gen_id }}">
        <div class="ai-price-tag-current-price-{{ ai_gen_id }}">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>

        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <div class="ai-price-tag-original-price-{{ ai_gen_id }}">
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </div>

          {% if block.settings.show_discount_percentage %}
            {% assign discount = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price %}
            {% assign discount_percentage = discount | times: 100.0 | divided_by: product.selected_or_first_available_variant.compare_at_price | round %}
            <div class="ai-price-tag-discount-{{ ai_gen_id }}">
              -{{ discount_percentage }}%
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</product-price-tag-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductPriceTag{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.updatePrices();
        this.setupVariantListener();
      }

      setupVariantListener() {
        const productForm = document.querySelector('product-form');
        if (productForm) {
          productForm.addEventListener('variant-change', (event) => {
            this.updatePricesFromVariant(event.detail.variant);
          });
        }
      }

      updatePricesFromVariant(variant) {
        if (!variant) return;

        const currentPriceEl = this.querySelector('.ai-price-tag-current-price-{{ ai_gen_id }}');
        const originalPriceEl = this.querySelector('.ai-price-tag-original-price-{{ ai_gen_id }}');
        const discountEl = this.querySelector('.ai-price-tag-discount-{{ ai_gen_id }}');

        if (currentPriceEl) {
          currentPriceEl.textContent = this.formatMoney(variant.price);
        }

        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          if (originalPriceEl) {
            originalPriceEl.textContent = this.formatMoney(variant.compare_at_price);
            originalPriceEl.style.display = 'block';
          }

          if (discountEl) {
            const discount = variant.compare_at_price - variant.price;
            const discountPercentage = Math.round((discount / variant.compare_at_price) * 100);
            discountEl.textContent = `-${discountPercentage}%`;
            discountEl.style.display = 'block';
          }
        } else {
          if (originalPriceEl) originalPriceEl.style.display = 'none';
          if (discountEl) discountEl.style.display = 'none';
        }
      }

      updatePrices() {
        const urlParams = new URLSearchParams(window.location.search);
        const variantId = urlParams.get('variant');

        if (variantId && window.productData) {
          const variant = window.productData.variants.find(v => v.id == variantId);
          if (variant) {
            this.updatePricesFromVariant(variant);
          }
        }
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return new Intl.NumberFormat('en-IN', {
          style: 'currency',
          currency: 'INR'
        }).format(amount);
      }
    }

    customElements.define('product-price-tag-{{ ai_gen_id }}', ProductPriceTag{{ ai_gen_id }});
  })();
</script>

