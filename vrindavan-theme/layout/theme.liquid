<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1B0A10">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = {
        routes: { predictiveSearch: {{ routes.predictive_search_url | json }}, cart: {{ routes.cart_url | json }} },
        strings: { add: {{ 'Add to cart' | json }}, soldOut: {{ 'Sold out' | json }} },
        currency: {{ cart.currency.iso_code | json }},
        formatMoney: function (cents) {
          try { return new Intl.NumberFormat('en-IN', { style: 'currency', currency: this.currency, maximumFractionDigits: 0 }).format(cents / 100); }
          catch (e) { return (cents / 100).toFixed(0); }
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handleize }}">
    <a class="skip" href="#main">Skip to content</a>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- assign wa = settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
    {%- if wa != blank -%}
      <a class="wa" href="https://wa.me/{{ wa }}" rel="noopener" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C7 3 3 6.600 3 11c0 2 .8 3.800 2.200 5.200L4 21l4.600-1.600c1 .4 2.200.6 3.400.6 5 0 9-3.600 9-8s-4-8-9-8z"/></svg>
      </a>
    {%- endif -%}
  </body>
</html>
