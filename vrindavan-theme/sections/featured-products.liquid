{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}
<section class="container section-pad reveal" {{ section.shopify_attributes }}>
  <div class="sec-head">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.show_view_all -%}<a href="{{ source.url }}">View all →</a>{%- endif -%}
  </div>
  {%- if source.products.size > 0 -%}
    <div class="grid">
      {%- for product in source.products limit: section.settings.count -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="empty-state"><p>Add products to this collection to show them here.</p></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Handpicked for you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured murtis" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use all products." },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 12, "step": 2, "default": 8 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
