{%- liquid
  assign hero_image = section.settings.image
  if hero_image == blank and section.settings.product != blank
    assign hero_image = section.settings.product.featured_media
  endif
  assign chips = linklists[section.settings.chips_menu]
-%}
<section class="hero-dusk" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="hero-copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="hero-cta">
        {%- if section.settings.button_label != blank -%}
          <a class="btn btn-gold" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
          <a class="btn btn-ghost-light" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if chips.links.size > 0 -%}
        <div class="hero-chips">
          {%- for link in chips.links limit: 8 -%}<a class="chip on-dark" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero-art">
      <span class="spark s1"></span><span class="spark s2"></span><span class="spark s3"></span><span class="spark s4"></span>
      {%- capture arch_href -%}{% if section.settings.product != blank %}{{ section.settings.product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}{%- endcapture -%}
      <a class="arch" href="{{ arch_href }}" aria-label="{{ section.settings.product.title | default: section.settings.heading | escape }}">
        {%- if hero_image != blank -%}
          {{ hero_image | image_url: width: 900 | image_tag:
              widths: '400, 600, 800, 900', sizes: '(min-width: 900px) 400px, 76vw',
              loading: 'eager', fetchpriority: 'high', alt: hero_image.alt | default: section.settings.heading }}
        {%- else -%}
          <img class="brand-fallback" src="{{ 'emblem.webp' | asset_url }}" width="480" height="480" alt="" loading="eager">
        {%- endif -%}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Murtis for the home mandir" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring the mandir home." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Browse by deity, material or occasion." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Shop all murtis" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "link_list", "id": "chips_menu", "label": "Quick-link chips (menu)", "info": "Create a menu such as Ganesha, Krishna, Lakshmi and pick it here." },
    { "type": "header", "content": "Picture inside the arch" },
    { "type": "product", "id": "product", "label": "Featured product", "info": "Uses the product's first photo." },
    { "type": "image_picker", "id": "image", "label": "Or choose an image", "info": "Overrides the product photo. Portrait 4:5 works best." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
