{%- comment -%}
  Product card. Usage: {% render 'product-card', product: product %}
  Optional metafields (namespace custom): material (text), height_cm (decimal).
{%- endcomment -%}
{%- liquid
  assign material = product.metafields.custom.material.value | default: product.type
  assign height = product.metafields.custom.height_cm.value
-%}
<article class="card">
  <button type="button" class="wish" data-wish="{{ product.handle }}" aria-pressed="false" aria-label="Add to wishlist">{% render 'icon', name: 'heart' %}</button>
  <a class="card-link" href="{{ product.url }}">
    <div class="card-img">
      {%- unless product.available -%}<span class="tag out">Sold out</span>{%- endunless -%}
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 800 | image_tag:
            widths: '360, 480, 640, 800',
            sizes: '(min-width: 900px) 25vw, 50vw',
            loading: 'lazy',
            alt: product.featured_media.alt | default: product.title }}
      {%- endif -%}
    </div>
    <div class="card-body">
      <h3 class="card-title">{{ product.title }}</h3>
      {%- if material != blank or height != blank -%}
        <div class="card-meta">{{ material }}{% if material != blank and height != blank %} · {% endif %}{% if height != blank %}{{ height }} cm{% endif %}</div>
      {%- endif -%}
      <div class="price">
        {%- if product.price_varies %}<span class="price-from">From </span>{% endif -%}
        {{ product.price | money_without_trailing_zeros }}
        {%- if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% endif -%}
      </div>
    </div>
  </a>
</article>
