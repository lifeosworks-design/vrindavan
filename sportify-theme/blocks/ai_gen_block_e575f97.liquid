{% doc %}
  @prompt
    create a moving slider for the shopify product collections
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-slider__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    padding: 0 20px;
  }

  .ai-collection-slider__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-collection-slider__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin-top: 8px;
  }

  .ai-collection-slider__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-collection-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    will-change: transform;
  }

  .ai-collection-slider__track-{{ ai_gen_id }}.ai-paused-{{ ai_gen_id }} {
    animation-play-state: paused;
  }

  .ai-collection-slider__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .ai-collection-slider__card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-collection-slider__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-collection-slider__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-slider__image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-collection-slider__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-slider__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-collection-slider__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-collection-slider__product-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_count_size }}px;
    color: {{ block.settings.product_count_color }};
    margin: 0;
  }

  .ai-collection-slider__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: {{ block.settings.controls_spacing }}px;
  }

  .ai-collection-slider__control-btn-{{ ai_gen_id }} {
    background-color: {{ block.settings.control_background }};
    color: {{ block.settings.control_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-collection-slider__control-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.control_hover_background }};
    transform: scale(1.1);
  }

  .ai-collection-slider__control-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-slider__card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.8 }}px;
    }

    .ai-collection-slider__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }
  }
{% endstyle %}

<collection-slider-{{ ai_gen_id }}
  class="ai-collection-slider-{{ ai_gen_id }}"
  data-speed="{{ block.settings.scroll_speed }}"
  data-direction="{{ block.settings.scroll_direction }}"
  data-pause-on-hover="{{ block.settings.pause_on_hover }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank or block.settings.subheading != blank %}
    <div class="ai-collection-slider__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-collection-slider__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <p class="ai-collection-slider__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-collection-slider__track-wrapper-{{ ai_gen_id }}">
    <div class="ai-collection-slider__track-{{ ai_gen_id }}">
      {% if block.settings.collections != blank %}
        {% for collection in block.settings.collections %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-slider__card-{{ ai_gen_id }}"
          >
            <div class="ai-collection-slider__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-slider__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-collection-slider__image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-collection-slider__content-{{ ai_gen_id }}">
              <h3 class="ai-collection-slider__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              {% if block.settings.show_product_count %}
                <p class="ai-collection-slider__product-count-{{ ai_gen_id }}">
                  {{ collection.products_count }}
                  {% if collection.products_count == 1 %}
                    product
                  {% else %}
                    products
                  {% endif %}
                </p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
        {% for collection in block.settings.collections %}
          <a
            href="{{ collection.url }}"
            class="ai-collection-slider__card-{{ ai_gen_id }}"
            aria-hidden="true"
          >
            <div class="ai-collection-slider__image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="ai-collection-slider__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-collection-slider__image-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-collection-slider__content-{{ ai_gen_id }}">
              <h3 class="ai-collection-slider__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              {% if block.settings.show_product_count %}
                <p class="ai-collection-slider__product-count-{{ ai_gen_id }}">
                  {{ collection.products_count }}
                  {% if collection.products_count == 1 %}
                    product
                  {% else %}
                    products
                  {% endif %}
                </p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          <div class="ai-collection-slider__card-{{ ai_gen_id }}">
            <div class="ai-collection-slider__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-collection-slider__image-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-collection-slider__content-{{ ai_gen_id }}">
              <h3 class="ai-collection-slider__title-{{ ai_gen_id }}">Collection {{ i }}</h3>
              {% if block.settings.show_product_count %}
                <p class="ai-collection-slider__product-count-{{ ai_gen_id }}">0 products</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
        {% for i in (1..6) %}
          <div class="ai-collection-slider__card-{{ ai_gen_id }}" aria-hidden="true">
            <div class="ai-collection-slider__image-wrapper-{{ ai_gen_id }}">
              <div class="ai-collection-slider__image-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="ai-collection-slider__content-{{ ai_gen_id }}">
              <h3 class="ai-collection-slider__title-{{ ai_gen_id }}">Collection {{ i }}</h3>
              {% if block.settings.show_product_count %}
                <p class="ai-collection-slider__product-count-{{ ai_gen_id }}">0 products</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  {% if block.settings.show_controls %}
    <div class="ai-collection-slider__controls-{{ ai_gen_id }}">
      <button
        class="ai-collection-slider__control-btn-{{ ai_gen_id }}"
        data-action="play-pause"
        aria-label="Play or pause slider"
      >
        <svg class="ai-pause-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="4" width="4" height="16"></rect>
          <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
        <svg class="ai-play-icon-{{ ai_gen_id }}" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
      </button>
      <button
        class="ai-collection-slider__control-btn-{{ ai_gen_id }}"
        data-action="reverse"
        aria-label="Reverse direction"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
    </div>
  {% endif %}
</collection-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-collection-slider__track-{{ ai_gen_id }}');
        this.speed = parseFloat(this.dataset.speed) || 1;
        this.direction = this.dataset.direction === 'right' ? 1 : -1;
        this.pauseOnHover = this.dataset.pauseOnHover === 'true';
        this.isPaused = false;
        this.position = 0;
        this.animationId = null;
      }

      connectedCallback() {
        this.setupAnimation();
        this.setupControls();
        if (this.pauseOnHover) {
          this.setupHoverPause();
        }
      }

      setupAnimation() {
        const animate = () => {
          if (!this.isPaused) {
            this.position += this.speed * this.direction;
            const trackWidth = this.track.scrollWidth / 2;
            
            if (this.direction === -1 && Math.abs(this.position) >= trackWidth) {
              this.position = 0;
            } else if (this.direction === 1 && this.position >= 0) {
              this.position = -trackWidth;
            }
            
            this.track.style.transform = `translateX(${this.position}px)`;
          }
          this.animationId = requestAnimationFrame(animate);
        };
        
        animate();
      }

      setupControls() {
        const playPauseBtn = this.querySelector('[data-action="play-pause"]');
        const reverseBtn = this.querySelector('[data-action="reverse"]');
        const playIcon = this.querySelector('.ai-play-icon-{{ ai_gen_id }}');
        const pauseIcon = this.querySelector('.ai-pause-icon-{{ ai_gen_id }}');

        if (playPauseBtn) {
          playPauseBtn.addEventListener('click', () => {
            this.isPaused = !this.isPaused;
            if (this.isPaused) {
              playIcon.style.display = 'block';
              pauseIcon.style.display = 'none';
            } else {
              playIcon.style.display = 'none';
              pauseIcon.style.display = 'block';
            }
          });
        }

        if (reverseBtn) {
          reverseBtn.addEventListener('click', () => {
            this.direction *= -1;
          });
        }
      }

      setupHoverPause() {
        this.track.addEventListener('mouseenter', () => {
          this.isPaused = true;
        });

        this.track.addEventListener('mouseleave', () => {
          this.isPaused = false;
        });
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
      }
    }

    customElements.define('collection-slider-{{ ai_gen_id }}', CollectionSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collection slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by collection"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our curated collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
